{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "http-in",
      "listen": "0.0.0.0",
      "port": 8080,
      "protocol": "http",
      "settings": {
        "users": [
          {
            "user": "change-me",
            "pass": "change-me-long-password"
          }
        ],
        "allowTransparent": false,
        "userLevel": 0
      }
    },
    {
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "users": [
          {
            "user": "change-me",
            "pass": "change-me-long-password"
          }
        ],
        "udp": false,
        "userLevel": 0
      }
    }
  ],
  "observatory": {
    "subjectSelector": [
      "proxy-"
    ],
    "probeUrl": "https://cp.cloudflare.com/generate_204",
    "probeInterval": "30s",
    "enableConcurrency": true
  },
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
      {
        "tag": "balancer-fastest",
        "selector": [
          "proxy-"
        ],
        "strategy": {
          "type": "leastPing"
        }
      }
    ],
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "http-in",
          "socks-in"
        ],
        "balancerTag": "balancer-fastest"
      }
    ]
  },
  "outbounds": [
    {
      "tag": "proxy-1",
      "protocol": "vless",
      "settings": {
        "address": "example1.com",
        "port": 443,
        "id": "00000000-0000-0000-0000-000000000000",
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "method": "raw",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "serverName": "www.example.com",
          "password": "REPLACE_WITH_REALITY_PUBLIC_KEY",
          "shortId": "",
          "spiderX": "/"
        }
      }
    },
    {
      "tag": "proxy-2",
      "protocol": "vless",
      "settings": {
        "address": "example2.com",
        "port": 8080,
        "id": "00000000-0000-0000-0000-000000000000",
        "encryption": "none"
      },
      "streamSettings": {
        "method": "raw",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "ios",
          "serverName": "graphs.4cdn.de",
          "password": "REPLACE_WITH_REALITY_PUBLIC_KEY",
          "shortId": "",
          "spiderX": "/"
        }
      }
    }
  ]
}
