{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "http-in",
      "listen": "0.0.0.0",
      "port": 8080,
      "protocol": "http",
      "settings": {
        "users": [
          {
            "user": "change-me",
            "pass": "change-me-long-password"
          }
        ],
        "allowTransparent": false,
        "userLevel": 0
      }
    },
    {
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "password",
        "users": [
          {
            "user": "change-me",
            "pass": "change-me-long-password"
          }
        ],
        "udp": false,
        "userLevel": 0
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless-out",
      "protocol": "vless",
      "settings": {
        "address": "example.com",
        "port": 443,
        "id": "00000000-0000-0000-0000-000000000000",
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "method": "raw",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "serverName": "www.example.com",
          "password": "REPLACE_WITH_REALITY_PUBLIC_KEY",
          "shortId": "",
          "spiderX": "/"
        }
      }
    }
  ]
}

