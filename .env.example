# Docker project settings
COMPOSE_PROJECT_NAME=xray-proxy
XRAY_IMAGE_TAG=26.7.11
XRAY_CONTAINER_NAME=xray-proxy
XRAY_NETWORK_NAME=xray-proxy-net
XRAY_NETWORK_ALIAS=xray-proxy

# Container-only proxy ports
HTTP_PROXY_PORT=8080
SOCKS_PROXY_PORT=1080
ENABLE_SOCKS=true
SOCKS_ENABLE_UDP=false

# Optional host publishing, used only with docker-compose.host.example.yml
HOST_BIND_IP=127.0.0.1
HOST_HTTP_PROXY_PORT=8080
HOST_SOCKS_PROXY_PORT=1080

# Proxy authentication
PROXY_USERNAME=change-me
PROXY_PASSWORD=change-me-long-password
ALLOW_UNAUTHENTICATED_PROXY=false

# Quote the URI so the fragment after # is preserved by dotenv parsers.
VLESS_URI='vless://00000000-0000-0000-0000-000000000000@example.com:443?encryption=none&security=reality&type=tcp&sni=www.example.com&fp=chrome&pbk=REPLACE_WITH_REALITY_PUBLIC_KEY&sid=&spx=%2F&flow=xtls-rprx-vision#xray-proxy'

# Automated test self-route guard
SELF_ROUTE_CHECK=auto
DIRECT_IP_URL=https://api.ipify.org

# Xray logging
XRAY_LOG_LEVEL=warning
XRAY_ACCESS_LOG=none
